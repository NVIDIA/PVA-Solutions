/*
 * The R5 launch fill covers the first 16 KiB. Keep Part 1 control and callees
 * before the tiny _main dispatcher. The Part 2 VPU request covers the separate
 * Part 2 control and compute stage through the program exit.
 *
 * This is a CMake template. The block-Cholesky kernels take VMEM-bank-qualified
 * pointers, and the bank qualifier is part of their mangled names. Its spelling
 * depends on the Chess frontend, so CMake substitutes the CAPON_ROI_MANGLED_RAM_*
 * placeholders with the form the selected PVA SDK produces.
 */
#define CUPVA_NOMAP_MAIN
#include <cupva_vpu.bcf>

/* Part 1 control is at the front of the launch-resident Part 1 block. */
_symbol capon_roi_part1_phase _next

